# Deployment. vercel --token=$VERCEL_TOKEN --yes
VERCEL_TOKEN=

# Optional. Without it the intent parser falls back to deterministic rules and the
# surface works exactly the same, minus the natural language flexibility.
VITE_ANTHROPIC_API_KEY=

# Off machine backup destination. Until this points somewhere synced or remote, the
# backup is a same volume mirror and does not survive the machine dying.
BACKUP_DIR=
