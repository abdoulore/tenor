# Deployment. vercel --token=$VERCEL_TOKEN --yes
VERCEL_TOKEN=

# Server side only. Never prefix this VITE_: Vite inlines those into the public bundle.
# Read by the /api/parse serverless function. Without it the parser falls back to rules.
ANTHROPIC_API_KEY=

# Off machine backup destination. Until this points somewhere synced or remote, the
# backup is a same volume mirror and does not survive the machine dying.
BACKUP_DIR=
