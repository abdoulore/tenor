node_modules/
.env
.env.*
!.env.example

# Collected samples. Large, append only, and regenerated by the sampler rather than
# authored. The .ndjson files are the irreplaceable part, so back them up outside git.
sampler/data/*.ndjson
sampler/data/*.log
sampler/data/*.pid
sampler/data/status.json
sampler/data/universe.json

# Prediction log. Append only, cannot be backfilled, and the basis for the receipts.
# Back these up outside git alongside the samples.
engine/predictions/*.ndjson
engine/predictions/*.log
engine/predictions/*.pid
